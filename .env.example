# API
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://eventra:eventra@localhost:5433/eventra?schema=public
# Web (Vite)
VITE_API_URL=http://localhost:3000/api/v1
# Mobile (Expo)
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Auth API (wajib; minimal 32 karakter acak, jangan di-commit)
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
# Seed admin pertama (pnpm db:seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ganti-password-kuat

# Akun contoh di halaman login (opsional, hanya dev; samakan dengan SEED_ADMIN_*)
VITE_DEMO_EMAIL=admin@example.com
VITE_DEMO_PASSWORD=ganti-password-kuat
