generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tabel fondasi: audit log append-only (TECHNICAL_SPEC §2, §4).
// Skema domain lain ditambahkan pada fase berikutnya melalui migrasi baru.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  ip        String?
  device    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum Role {
  OWNER
  ADMIN
  OPS_COORDINATOR
  WAREHOUSE
  FIELD_PIC
  CUSTOMER
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

enum PricingUnit {
  PCS
  PACKAGE
}

// Capability per role didefinisikan di @eventra/shared (rbac.ts), bukan di tabel.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  phone        String?
  passwordHash String   @map("password_hash")
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

// Hanya hash token yang disimpan; token asli tidak pernah masuk database.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_tokens")
}

model Customer {
  id               String            @id @default(uuid()) @db.Uuid
  type             CustomerType
  name             String
  email            String?
  phone            String?
  address          String?
  verificationNote String?           @map("verification_note")
  active           Boolean           @default(true)
  createdBy        String?           @map("created_by") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  contacts         CustomerContact[]

  @@index([name])
  @@map("customers")
}

// PIC penyewa. Dinonaktifkan (bukan dihapus) agar riwayat pesanan tetap utuh.
model CustomerContact {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  name       String
  phone      String
  position   String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer   Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("customer_contacts")
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  products  Product[]

  @@map("categories")
}

model Location {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("locations")
}

// Nominal rupiah disimpan sebagai integer.
model Product {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  sku         String?     @unique
  categoryId  String      @map("category_id") @db.Uuid
  pricingUnit PricingUnit @map("pricing_unit")
  unitLabel   String      @map("unit_label")
  price       BigInt
  deposit     BigInt      @default(0)
  active      Boolean     @default(true)
  createdBy   String?     @map("created_by") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  category    Category    @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@map("products")
}
