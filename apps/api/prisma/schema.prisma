generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tabel fondasi: audit log append-only (TECHNICAL_SPEC §2, §4).
// Skema domain lain ditambahkan pada fase berikutnya melalui migrasi baru.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  ip        String?
  device    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum Role {
  OWNER
  ADMIN
  OPS_COORDINATOR
  WAREHOUSE
  FIELD_PIC
  CUSTOMER
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

enum PricingUnit {
  PCS
  PACKAGE
}

// Capability per role didefinisikan di @eventra/shared (rbac.ts), bukan di tabel.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  phone        String?
  passwordHash String   @map("password_hash")
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  assetEvents         AssetStatusEvent[]
  receipts            StockReceipt[]
  picUsers            OrderPic[]         @relation("PicUser")
  picApprovals        OrderPic[]         @relation("PicApprover")
  orderEvents         OrderStatusEvent[]

  @@map("users")
}

// Hanya hash token yang disimpan; token asli tidak pernah masuk database.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_tokens")
}

model Customer {
  id               String       @id @default(uuid()) @db.Uuid
  type             CustomerType
  name             String
  email            String?
  phone            String?
  address          String?
  verificationNote String?      @map("verification_note")
  active           Boolean      @default(true)
  createdBy        String?      @map("created_by") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  orders           Order[]

  @@index([name])
  @@map("customers")
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  products  Product[]

  @@map("categories")
}

model Location {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  assets     Asset[]
  receipts   StockReceipt[]
  eventsFrom AssetStatusEvent[] @relation("EventFromLocation")
  eventsTo   AssetStatusEvent[] @relation("EventToLocation")

  @@map("locations")
}

// Nominal rupiah disimpan sebagai integer.
model Product {
  id           String             @id @default(uuid()) @db.Uuid
  name         String
  sku          String?            @unique
  categoryId   String             @map("category_id") @db.Uuid
  pricingUnit  PricingUnit        @map("pricing_unit")
  unitLabel    String             @map("unit_label")
  price        BigInt
  deposit      BigInt             @default(0)
  active       Boolean            @default(true)
  createdBy    String?            @map("created_by") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  category     Category           @relation(fields: [categoryId], references: [id])
  assets       Asset[]
  receiptItems StockReceiptItem[]
  bundleOf     ProductBundle[]    @relation("BundleProduct")
  usedIn       ProductBundle[]    @relation("BundleComponent")
  orderItems   OrderItem[]
  allocations  StockAllocation[]

  @@index([categoryId])
  @@map("products")
}

// ---------- Fase 02: aset, QR, penerimaan stok, riwayat ----------

enum AssetStatus {
  AVAILABLE
  RESERVED
  PREPARED
  CHECKED_OUT
  IN_TRANSIT
  ON_SITE
  RETURN_PENDING
  IN_SERVICE
  QUARANTINED
  RETIRED
  ISSUE_ON_SITE
}

enum AssetCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum ReceiptSource {
  PURCHASE
  TRANSFER
  GRANT
  CONSIGNMENT
  PRODUCTION
  OTHER
}

enum ReceiptStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum AssetEventType {
  RECEIVED
  CREATED
  STATUS_CHANGED
  CONDITION_CHANGED
  LOCATION_CHANGED
  QR_REGENERATED
  UPDATED
}

// Satu baris = satu aset fisik per-unit. purchasePrice sensitif (capability asset.cost.read).
model Asset {
  id            String         @id @default(uuid()) @db.Uuid
  code          String         @unique
  qrToken       String         @unique @map("qr_token")
  productId     String         @map("product_id") @db.Uuid
  serial        String?
  condition     AssetCondition @default(GOOD)
  status        AssetStatus    @default(AVAILABLE)
  locationId    String?        @map("location_id") @db.Uuid
  supplier      String?
  purchaseDate  DateTime?      @map("purchase_date") @db.Date
  purchasePrice BigInt?        @map("purchase_price")
  receiptId     String?        @map("receipt_id") @db.Uuid
  notes         String?
  createdBy     String?        @map("created_by") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  product  Product            @relation(fields: [productId], references: [id])
  location Location?          @relation(fields: [locationId], references: [id])
  receipt  StockReceipt?      @relation(fields: [receiptId], references: [id])
  events   AssetStatusEvent[]

  @@unique([productId, serial])
  @@index([productId])
  @@index([status])
  @@index([condition])
  @@index([locationId])
  @@index([receiptId])
  @@map("assets")
}

// Append-only: tidak ada update/delete pada tabel ini.
model AssetStatusEvent {
  id             String          @id @default(uuid()) @db.Uuid
  assetId        String          @map("asset_id") @db.Uuid
  type           AssetEventType
  fromStatus     AssetStatus?    @map("from_status")
  toStatus       AssetStatus?    @map("to_status")
  fromCondition  AssetCondition? @map("from_condition")
  toCondition    AssetCondition? @map("to_condition")
  fromLocationId String?         @map("from_location_id") @db.Uuid
  toLocationId   String?         @map("to_location_id") @db.Uuid
  receiptId      String?         @map("receipt_id") @db.Uuid
  note           String?
  actorId        String?         @map("actor_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  asset        Asset     @relation(fields: [assetId], references: [id])
  actor        User?     @relation(fields: [actorId], references: [id])
  fromLocation Location? @relation("EventFromLocation", fields: [fromLocationId], references: [id])
  toLocation   Location? @relation("EventToLocation", fields: [toLocationId], references: [id])

  @@index([assetId, createdAt])
  @@map("asset_status_events")
}

model StockReceipt {
  id           String        @id @default(uuid()) @db.Uuid
  number       String        @unique
  source       ReceiptSource
  status       ReceiptStatus @default(DRAFT)
  sourceRef    String?       @map("source_ref")
  supplier     String?
  locationId   String        @map("location_id") @db.Uuid
  receivedDate DateTime      @map("received_date") @db.Date
  receivedById String?       @map("received_by_id") @db.Uuid
  receivedAt   DateTime?     @map("received_at") @db.Timestamptz(3)
  note         String?
  createdBy    String?       @map("created_by") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  location Location           @relation(fields: [locationId], references: [id])
  receiver User?              @relation(fields: [receivedById], references: [id])
  items    StockReceiptItem[]
  assets   Asset[]

  @@index([status])
  @@map("stock_receipts")
}

model StockReceiptItem {
  id        String         @id @default(uuid()) @db.Uuid
  receiptId String         @map("receipt_id") @db.Uuid
  productId String         @map("product_id") @db.Uuid
  quantity  Int
  unitCost  BigInt?        @map("unit_cost")
  condition AssetCondition @default(GOOD)
  serials   String[]

  receipt StockReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])

  @@index([receiptId])
  @@map("stock_receipt_items")
}

// ---------- Fase 03: paket, ketersediaan, pesanan ----------

enum OrderStatus {
  DRAFT
  PENDING_REVIEW
  QUOTED
  AWAITING_PAYMENT
  CONFIRMED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
  EXPIRED
  ISSUE
}

enum AllocationStatus {
  HOLD
  CONFIRMED
  RELEASED
}

enum PicRole {
  CUSTOMER_PIC
  WAREHOUSE_OUT
  WAREHOUSE_IN
  FIELD
}

enum PicSource {
  OWNER
  CUSTOMER
  THIRD_PARTY
}

// 1 satuan sewa `product` membutuhkan `quantity` aset fisik `component` (mis. 1 meter LED → 4 panel).
// Produk tanpa baris di tabel ini dipenuhi oleh asetnya sendiri (rasio 1).
model ProductBundle {
  id                 String   @id @default(uuid()) @db.Uuid
  productId          String   @map("product_id") @db.Uuid
  componentProductId String   @map("component_product_id") @db.Uuid
  quantity           Int
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product   Product @relation("BundleProduct", fields: [productId], references: [id])
  component Product @relation("BundleComponent", fields: [componentProductId], references: [id])

  @@unique([productId, componentProductId])
  @@index([componentProductId])
  @@map("product_bundles")
}

model Order {
  id            String      @id @default(uuid()) @db.Uuid
  number        String      @unique
  customerId    String      @map("customer_id") @db.Uuid
  status        OrderStatus @default(DRAFT)
  startDate     DateTime    @map("start_date") @db.Date
  endDate       DateTime    @map("end_date") @db.Date
  eventLocation String      @map("event_location")
  note          String?
  subtotal      BigInt      @default(0)
  depositTotal  BigInt      @default(0) @map("deposit_total")
  holdExpiresAt DateTime?   @map("hold_expires_at") @db.Timestamptz(3)
  confirmedAt   DateTime?   @map("confirmed_at") @db.Timestamptz(3)
  createdBy     String?     @map("created_by") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer    Customer           @relation(fields: [customerId], references: [id])
  items       OrderItem[]
  quotes      OrderQuote[]
  allocations StockAllocation[]
  pics        OrderPic[]
  events      OrderStatusEvent[]

  @@index([customerId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("orders")
}

model OrderItem {
  id          String @id @default(uuid()) @db.Uuid
  orderId     String @map("order_id") @db.Uuid
  productId   String @map("product_id") @db.Uuid
  quantity    Int
  unitPrice   BigInt @map("unit_price")
  unitDeposit BigInt @default(0) @map("unit_deposit")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
  @@map("order_items")
}

// Append-only: setiap penawaran adalah versi baru.
model OrderQuote {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  version      Int
  subtotal     BigInt
  depositTotal BigInt   @map("deposit_total")
  note         String?
  snapshot     Json
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id])

  @@unique([orderId, version])
  @@map("order_quotes")
}

// Append-only: alokasi tidak dihapus; pelepasan = status RELEASED. `productId` adalah produk pemenuhan
// (komponen fisik). Unik per (order, produk, tanggal) selama belum RELEASED (indeks parsial di migrasi).
model StockAllocation {
  id         String           @id @default(uuid()) @db.Uuid
  orderId    String           @map("order_id") @db.Uuid
  productId  String           @map("product_id") @db.Uuid
  date       DateTime         @db.Date
  quantity   Int
  status     AllocationStatus
  expiresAt  DateTime?        @map("expires_at") @db.Timestamptz(3)
  releasedAt DateTime?        @map("released_at") @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([productId, date, status])
  @@index([orderId])
  @@map("stock_allocations")
}

model OrderPic {
  id            String    @id @default(uuid()) @db.Uuid
  orderId       String    @map("order_id") @db.Uuid
  role          PicRole
  source        PicSource
  userId        String?   @map("user_id") @db.Uuid
  name          String
  phone         String?
  organization  String?
  authorization String?
  approvedById  String?   @map("approved_by_id") @db.Uuid
  approvedAt    DateTime? @map("approved_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user       User? @relation("PicUser", fields: [userId], references: [id])
  approvedBy User? @relation("PicApprover", fields: [approvedById], references: [id])

  @@index([orderId])
  @@map("order_pics")
}

// Append-only: riwayat status pesanan beserta pelaku (FR-04).
model OrderStatusEvent {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  note       String?
  actorId    String?      @map("actor_id") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id])
  actor User? @relation(fields: [actorId], references: [id])

  @@index([orderId, createdAt])
  @@map("order_status_events")
}
