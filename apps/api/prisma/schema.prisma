generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tabel fondasi: audit log append-only (TECHNICAL_SPEC §2, §4).
// Skema domain lain ditambahkan pada fase berikutnya melalui migrasi baru.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  ip        String?
  device    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum Role {
  OWNER
  ADMIN
  OPS_COORDINATOR
  WAREHOUSE
  FIELD_PIC
  CUSTOMER
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

enum PricingUnit {
  PCS
  PACKAGE
}

// Capability per role didefinisikan di @eventra/shared (rbac.ts), bukan di tabel.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  phone        String?
  passwordHash String   @map("password_hash")
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  assetEvents         AssetStatusEvent[]
  receipts            StockReceipt[]
  picUsers            OrderPic[]           @relation("PicUser")
  picApprovals        OrderPic[]           @relation("PicApprover")
  orderEvents         OrderStatusEvent[]
  scanEvents          ScanEvent[]
  incidentsReported   Incident[]           @relation("IncidentReporter")
  incidentsReviewed   Incident[]           @relation("IncidentReviewer")
  incidentEvents      IncidentEvent[]
  notifications       Notification[]

  @@map("users")
}

// Hanya hash token yang disimpan; token asli tidak pernah masuk database.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_tokens")
}

model Customer {
  id               String       @id @default(uuid()) @db.Uuid
  type             CustomerType
  name             String
  email            String?
  phone            String?
  address          String?
  verificationNote String?      @map("verification_note")
  active           Boolean      @default(true)
  createdBy        String?      @map("created_by") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  orders           Order[]

  @@index([name])
  @@map("customers")
}

// Foto produk opsional (maks. 1, boleh diganti/dihapus). Byte terpisah dari products agar daftar tetap ringan.
model ProductPhoto {
  productId String   @id @map("product_id") @db.Uuid
  mimeType  String   @map("mime_type")
  data      Bytes
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id])

  @@map("product_photos")
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  products  Product[]

  @@map("categories")
}

model Location {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  assets     Asset[]
  receipts   StockReceipt[]
  eventsFrom AssetStatusEvent[] @relation("EventFromLocation")
  eventsTo   AssetStatusEvent[] @relation("EventToLocation")

  @@map("locations")
}

// Nominal rupiah disimpan sebagai integer.
model Product {
  id            String             @id @default(uuid()) @db.Uuid
  name          String
  sku           String?            @unique
  categoryId    String             @map("category_id") @db.Uuid
  pricingUnit   PricingUnit        @map("pricing_unit")
  unitLabel     String             @map("unit_label")
  price         BigInt
  deposit       BigInt             @default(0)
  active        Boolean            @default(true)
  hasPhoto      Boolean            @default(false) @map("has_photo")
  createdBy     String?            @map("created_by") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  category      Category           @relation(fields: [categoryId], references: [id])
  photo         ProductPhoto?
  assets        Asset[]
  receiptItems  StockReceiptItem[]
  bundleOf      ProductBundle[]    @relation("BundleProduct")
  usedIn        ProductBundle[]    @relation("BundleComponent")
  orderItems    OrderItem[]
  allocations   StockAllocation[]
  pickListLines PickListLine[]
  pickListItems PickListItem[]

  @@index([categoryId])
  @@map("products")
}

// ---------- Fase 02: aset, QR, penerimaan stok, riwayat ----------

enum AssetStatus {
  AVAILABLE
  RESERVED
  PREPARED
  CHECKED_OUT
  IN_TRANSIT
  ON_SITE
  RETURN_PENDING
  IN_SERVICE
  QUARANTINED
  RETIRED
  ISSUE_ON_SITE
}

enum AssetCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum ReceiptSource {
  PURCHASE
  TRANSFER
  GRANT
  CONSIGNMENT
  PRODUCTION
  OTHER
}

enum ReceiptStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum AssetEventType {
  RECEIVED
  CREATED
  STATUS_CHANGED
  CONDITION_CHANGED
  LOCATION_CHANGED
  QR_REGENERATED
  UPDATED
}

// Satu baris = satu aset fisik per-unit. purchasePrice sensitif (capability asset.cost.read).
model Asset {
  id            String         @id @default(uuid()) @db.Uuid
  code          String         @unique
  qrToken       String         @unique @map("qr_token")
  productId     String         @map("product_id") @db.Uuid
  serial        String?
  condition     AssetCondition @default(GOOD)
  status        AssetStatus    @default(AVAILABLE)
  locationId    String?        @map("location_id") @db.Uuid
  supplier      String?
  purchaseDate  DateTime?      @map("purchase_date") @db.Date
  purchasePrice BigInt?        @map("purchase_price")
  receiptId     String?        @map("receipt_id") @db.Uuid
  notes         String?
  createdBy     String?        @map("created_by") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  product        Product            @relation(fields: [productId], references: [id])
  location       Location?          @relation(fields: [locationId], references: [id])
  receipt        StockReceipt?      @relation(fields: [receiptId], references: [id])
  events         AssetStatusEvent[]
  pickListItems  PickListItem[]
  scanEvents     ScanEvent[]
  incidents      Incident[]
  serviceTickets ServiceTicket[]
  replacedBy     ReplacementTask[]  @relation("ReplacementOldAsset")
  replacementFor ReplacementTask[]  @relation("ReplacementNewAsset")

  @@unique([productId, serial])
  @@index([productId])
  @@index([status])
  @@index([condition])
  @@index([locationId])
  @@index([receiptId])
  @@map("assets")
}

// Append-only: tidak ada update/delete pada tabel ini.
model AssetStatusEvent {
  id             String          @id @default(uuid()) @db.Uuid
  assetId        String          @map("asset_id") @db.Uuid
  type           AssetEventType
  fromStatus     AssetStatus?    @map("from_status")
  toStatus       AssetStatus?    @map("to_status")
  fromCondition  AssetCondition? @map("from_condition")
  toCondition    AssetCondition? @map("to_condition")
  fromLocationId String?         @map("from_location_id") @db.Uuid
  toLocationId   String?         @map("to_location_id") @db.Uuid
  receiptId      String?         @map("receipt_id") @db.Uuid
  note           String?
  actorId        String?         @map("actor_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  asset        Asset     @relation(fields: [assetId], references: [id])
  actor        User?     @relation(fields: [actorId], references: [id])
  fromLocation Location? @relation("EventFromLocation", fields: [fromLocationId], references: [id])
  toLocation   Location? @relation("EventToLocation", fields: [toLocationId], references: [id])

  @@index([assetId, createdAt])
  @@map("asset_status_events")
}

model StockReceipt {
  id           String        @id @default(uuid()) @db.Uuid
  number       String        @unique
  source       ReceiptSource
  status       ReceiptStatus @default(DRAFT)
  sourceRef    String?       @map("source_ref")
  supplier     String?
  locationId   String        @map("location_id") @db.Uuid
  receivedDate DateTime      @map("received_date") @db.Date
  receivedById String?       @map("received_by_id") @db.Uuid
  receivedAt   DateTime?     @map("received_at") @db.Timestamptz(3)
  note         String?
  createdBy    String?       @map("created_by") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  location Location           @relation(fields: [locationId], references: [id])
  receiver User?              @relation(fields: [receivedById], references: [id])
  items    StockReceiptItem[]
  assets   Asset[]

  @@index([status])
  @@map("stock_receipts")
}

model StockReceiptItem {
  id        String         @id @default(uuid()) @db.Uuid
  receiptId String         @map("receipt_id") @db.Uuid
  productId String         @map("product_id") @db.Uuid
  quantity  Int
  unitCost  BigInt?        @map("unit_cost")
  condition AssetCondition @default(GOOD)
  serials   String[]

  receipt StockReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])

  @@index([receiptId])
  @@map("stock_receipt_items")
}

// ---------- Fase 03: paket, ketersediaan, pesanan ----------

enum OrderStatus {
  DRAFT
  PENDING_REVIEW
  QUOTED
  AWAITING_PAYMENT
  CONFIRMED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
  EXPIRED
  ISSUE
}

enum AllocationStatus {
  HOLD
  CONFIRMED
  RELEASED
}

enum PicRole {
  CUSTOMER_PIC
  WAREHOUSE_OUT
  WAREHOUSE_IN
  FIELD
}

enum PicSource {
  OWNER
  CUSTOMER
  THIRD_PARTY
}

// 1 satuan sewa `product` membutuhkan `quantity` aset fisik `component` (mis. 1 meter LED → 4 panel).
// Produk tanpa baris di tabel ini dipenuhi oleh asetnya sendiri (rasio 1).
model ProductBundle {
  id                 String   @id @default(uuid()) @db.Uuid
  productId          String   @map("product_id") @db.Uuid
  componentProductId String   @map("component_product_id") @db.Uuid
  quantity           Int
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product   Product @relation("BundleProduct", fields: [productId], references: [id])
  component Product @relation("BundleComponent", fields: [componentProductId], references: [id])

  @@unique([productId, componentProductId])
  @@index([componentProductId])
  @@map("product_bundles")
}

model Order {
  id            String      @id @default(uuid()) @db.Uuid
  number        String      @unique
  customerId    String      @map("customer_id") @db.Uuid
  status        OrderStatus @default(DRAFT)
  startDate     DateTime    @map("start_date") @db.Date
  endDate       DateTime    @map("end_date") @db.Date
  eventLocation String      @map("event_location")
  note          String?
  subtotal      BigInt      @default(0)
  depositTotal  BigInt      @default(0) @map("deposit_total")
  holdExpiresAt DateTime?   @map("hold_expires_at") @db.Timestamptz(3)
  confirmedAt   DateTime?   @map("confirmed_at") @db.Timestamptz(3)
  createdBy     String?     @map("created_by") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer          Customer           @relation(fields: [customerId], references: [id])
  items             OrderItem[]
  quotes            OrderQuote[]
  allocations       StockAllocation[]
  pics              OrderPic[]
  events            OrderStatusEvent[]
  pickLists         PickList[]
  handoverDocuments HandoverDocument[]
  incidents         Incident[]
  replacementTasks  ReplacementTask[]
  invoices          Invoice[]

  @@index([customerId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("orders")
}

model OrderItem {
  id          String @id @default(uuid()) @db.Uuid
  orderId     String @map("order_id") @db.Uuid
  productId   String @map("product_id") @db.Uuid
  quantity    Int
  unitPrice   BigInt @map("unit_price")
  unitDeposit BigInt @default(0) @map("unit_deposit")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
  @@map("order_items")
}

// Append-only: setiap penawaran adalah versi baru.
model OrderQuote {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  version      Int
  subtotal     BigInt
  depositTotal BigInt   @map("deposit_total")
  note         String?
  snapshot     Json
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id])

  @@unique([orderId, version])
  @@map("order_quotes")
}

// Append-only: alokasi tidak dihapus; pelepasan = status RELEASED. `productId` adalah produk pemenuhan
// (komponen fisik). Unik per (order, produk, tanggal) selama belum RELEASED (indeks parsial di migrasi).
model StockAllocation {
  id         String           @id @default(uuid()) @db.Uuid
  orderId    String           @map("order_id") @db.Uuid
  productId  String           @map("product_id") @db.Uuid
  date       DateTime         @db.Date
  quantity   Int
  status     AllocationStatus
  expiresAt  DateTime?        @map("expires_at") @db.Timestamptz(3)
  releasedAt DateTime?        @map("released_at") @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([productId, date, status])
  @@index([orderId])
  @@map("stock_allocations")
}

model OrderPic {
  id            String    @id @default(uuid()) @db.Uuid
  orderId       String    @map("order_id") @db.Uuid
  role          PicRole
  source        PicSource
  userId        String?   @map("user_id") @db.Uuid
  name          String
  phone         String?
  organization  String?
  authorization String?
  approvedById  String?   @map("approved_by_id") @db.Uuid
  approvedAt    DateTime? @map("approved_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user       User? @relation("PicUser", fields: [userId], references: [id])
  approvedBy User? @relation("PicApprover", fields: [approvedById], references: [id])

  @@index([orderId])
  @@map("order_pics")
}

// Append-only: riwayat status pesanan beserta pelaku (FR-04).
model OrderStatusEvent {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  note       String?
  actorId    String?      @map("actor_id") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id])
  actor User? @relation(fields: [actorId], references: [id])

  @@index([orderId, createdAt])
  @@map("order_status_events")
}

// ---------- Fase 04: gudang, scan, dokumen serah-terima ----------

enum PickListStatus {
  OPEN
  VERIFIED
  DISPATCHED
  RETURNED
  RETURN_ISSUE
  CANCELLED
}

enum PickItemStatus {
  PICKED
  VERIFIED
  DISPATCHED
  RETURNED
  MISSING
  REMOVED
}

enum ScanAction {
  PICK
  UNPICK
  VERIFY
  CHECKOUT
  RETURN
  RETURN_MISSING
  INCIDENT_SCAN
  REPLACEMENT_PICK
  REPLACEMENT_UNPICK
  REPLACEMENT_VERIFY
  REPLACEMENT_DISPATCH
  REPLACEMENT_RECEIVE
}

enum ScanResult {
  OK
  REJECTED
}

enum ScanMethod {
  QR
  MANUAL
}

enum HandoverType {
  OUT
  RETURN
}

enum SignerRole {
  WAREHOUSE
  COUNTERPART
}

// Satu pick list aktif per pesanan (indeks parsial di migrasi). Kebutuhan fisik = `lines`.
model PickList {
  id           String         @id @default(uuid()) @db.Uuid
  number       String         @unique
  orderId      String         @map("order_id") @db.Uuid
  status       PickListStatus @default(OPEN)
  dispatchedAt DateTime?      @map("dispatched_at") @db.Timestamptz(3)
  returnedAt   DateTime?      @map("returned_at") @db.Timestamptz(3)
  createdBy    String?        @map("created_by") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  order     Order              @relation(fields: [orderId], references: [id])
  lines     PickListLine[]
  items     PickListItem[]
  scans     ScanEvent[]
  documents HandoverDocument[]

  @@index([orderId])
  @@index([status])
  @@map("pick_lists")
}

// Kebutuhan fisik per produk pemenuhan (hasil konversi paket saat pick list dibuat).
model PickListLine {
  id         String @id @default(uuid()) @db.Uuid
  pickListId String @map("pick_list_id") @db.Uuid
  productId  String @map("product_id") @db.Uuid
  quantity   Int

  pickList PickList @relation(fields: [pickListId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([pickListId, productId])
  @@map("pick_list_lines")
}

// Aset terpilih. Baris tidak dihapus: pelepasan = status REMOVED.
model PickListItem {
  id                String          @id @default(uuid()) @db.Uuid
  pickListId        String          @map("pick_list_id") @db.Uuid
  assetId           String          @map("asset_id") @db.Uuid
  productId         String          @map("product_id") @db.Uuid
  status            PickItemStatus  @default(PICKED)
  pickedAt          DateTime        @default(now()) @map("picked_at") @db.Timestamptz(3)
  verifiedAt        DateTime?       @map("verified_at") @db.Timestamptz(3)
  dispatchedAt      DateTime?       @map("dispatched_at") @db.Timestamptz(3)
  dispatchCondition AssetCondition? @map("dispatch_condition")
  returnedAt        DateTime?       @map("returned_at") @db.Timestamptz(3)
  returnCondition   AssetCondition? @map("return_condition")
  returnNote        String?         @map("return_note")

  pickList PickList    @relation(fields: [pickListId], references: [id], onDelete: Cascade)
  asset    Asset       @relation(fields: [assetId], references: [id])
  product  Product     @relation(fields: [productId], references: [id])
  photos   ScanPhoto[]

  @@index([pickListId])
  @@index([assetId])
  @@map("pick_list_items")
}

// Append-only: setiap scan (berhasil maupun ditolak) tercatat beserta pelaksananya.
model ScanEvent {
  id                String          @id @default(uuid()) @db.Uuid
  action            ScanAction
  result            ScanResult
  method            ScanMethod
  reason            String?
  pickListId        String?         @map("pick_list_id") @db.Uuid
  orderId           String?         @map("order_id") @db.Uuid
  assetId           String?         @map("asset_id") @db.Uuid
  condition         AssetCondition?
  note              String?
  actorId           String?         @map("actor_id") @db.Uuid
  incidentId        String?         @map("incident_id") @db.Uuid
  replacementTaskId String?         @map("replacement_task_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  pickList        PickList?        @relation(fields: [pickListId], references: [id])
  asset           Asset?           @relation(fields: [assetId], references: [id])
  actor           User?            @relation(fields: [actorId], references: [id])
  incident        Incident?        @relation(fields: [incidentId], references: [id])
  replacementTask ReplacementTask? @relation(fields: [replacementTaskId], references: [id])

  @@index([pickListId, createdAt])
  @@index([assetId, createdAt])
  @@map("scan_events")
}

// Foto bukti kondisi saat pengembalian (maks. 5 per item, ditegakkan backend).
model ScanPhoto {
  id        String   @id @default(uuid()) @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  mimeType  String   @map("mime_type")
  data      Bytes
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  item PickListItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("scan_photos")
}

// Immutable: tidak pernah diubah setelah dibuat. Revisi = baris baru (version+1, nomor sama).
model HandoverDocument {
  id             String       @id @default(uuid()) @db.Uuid
  number         String
  version        Int          @default(1)
  type           HandoverType
  orderId        String       @map("order_id") @db.Uuid
  pickListId     String       @map("pick_list_id") @db.Uuid
  payload        Json
  revisionReason String?      @map("revision_reason")
  createdBy      String?      @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  order      Order               @relation(fields: [orderId], references: [id])
  pickList   PickList            @relation(fields: [pickListId], references: [id])
  signatures DocumentSignature[]

  @@unique([number, version])
  @@index([orderId, type])
  @@index([pickListId])
  @@map("handover_documents")
}

// Append-only: satu tanda tangan per peran per dokumen.
model DocumentSignature {
  id         String     @id @default(uuid()) @db.Uuid
  documentId String     @map("document_id") @db.Uuid
  role       SignerRole
  picId      String?    @map("pic_id") @db.Uuid
  signerName String     @map("signer_name")
  signerRole String     @map("signer_role")
  image      Bytes
  signedBy   String?    @map("signed_by") @db.Uuid
  signedAt   DateTime   @default(now()) @map("signed_at") @db.Timestamptz(3)

  document HandoverDocument @relation(fields: [documentId], references: [id])

  @@unique([documentId, role])
  @@map("document_signatures")
}

// ---------- Fase 05: insiden, servis, aset pengganti ----------

enum IncidentUrgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  DRAFT
  REPORTED
  GUIDANCE_GIVEN
  TECHNICIAN_ASSIGNED
  REPLACEMENT_IN_PROGRESS
  REPLACED
  REJECTED
  CLOSED
}

enum IncidentDecision {
  GUIDANCE
  TECHNICIAN
  REJECT
  REPLACE
}

enum ServiceTicketStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InspectionResult {
  PASSED
  FAILED
}

enum ReplacementStatus {
  PENDING_PICK
  PICKED
  VERIFIED
  DISPATCHED
  RECEIVED
  CANCELLED
}

// Laporan kerusakan dari lapangan. DRAFT sampai 1–5 foto terlampir lalu dikirim (submit).
model Incident {
  id                   String            @id @default(uuid()) @db.Uuid
  number               String            @unique
  assetId              String            @map("asset_id") @db.Uuid
  orderId              String            @map("order_id") @db.Uuid
  pickListId           String            @map("pick_list_id") @db.Uuid
  reporterId           String            @map("reporter_id") @db.Uuid
  urgency              IncidentUrgency
  description          String
  locationNote         String?           @map("location_note")
  status               IncidentStatus    @default(DRAFT)
  assetStatusBefore    AssetStatus?      @map("asset_status_before")
  assetConditionBefore AssetCondition?   @map("asset_condition_before")
  decision             IncidentDecision?
  decisionNote         String?           @map("decision_note")
  technicianName       String?           @map("technician_name")
  reviewedBy           String?           @map("reviewed_by") @db.Uuid
  reviewedAt           DateTime?         @map("reviewed_at") @db.Timestamptz(3)
  reportedAt           DateTime?         @map("reported_at") @db.Timestamptz(3)
  closedAt             DateTime?         @map("closed_at") @db.Timestamptz(3)
  closeNote            String?           @map("close_note")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  asset            Asset             @relation(fields: [assetId], references: [id])
  order            Order             @relation(fields: [orderId], references: [id])
  reporter         User              @relation("IncidentReporter", fields: [reporterId], references: [id])
  reviewer         User?             @relation("IncidentReviewer", fields: [reviewedBy], references: [id])
  photos           IncidentPhoto[]
  events           IncidentEvent[]
  serviceTickets   ServiceTicket[]
  replacementTasks ReplacementTask[]
  scans            ScanEvent[]

  @@index([assetId])
  @@index([orderId])
  @@index([status])
  @@index([reporterId])
  @@map("incidents")
}

// Bukti foto insiden: append-only (trigger), maks. 5 per insiden (ditegakkan backend dalam transaksi berkunci).
model IncidentPhoto {
  id         String   @id @default(uuid()) @db.Uuid
  incidentId String   @map("incident_id") @db.Uuid
  mimeType   String   @map("mime_type")
  data       Bytes
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  incident Incident @relation(fields: [incidentId], references: [id])

  @@index([incidentId])
  @@map("incident_photos")
}

// Append-only: riwayat status insiden beserta pelaku.
model IncidentEvent {
  id         String          @id @default(uuid()) @db.Uuid
  incidentId String          @map("incident_id") @db.Uuid
  fromStatus IncidentStatus? @map("from_status")
  toStatus   IncidentStatus  @map("to_status")
  note       String?
  actorId    String?         @map("actor_id") @db.Uuid
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  incident Incident @relation(fields: [incidentId], references: [id])
  actor    User?    @relation(fields: [actorId], references: [id])

  @@index([incidentId, createdAt])
  @@map("incident_events")
}

// Satu tiket servis terbuka (OPEN/IN_PROGRESS) per aset (indeks parsial di migrasi). Biaya sensitif (asset.cost.read).
model ServiceTicket {
  id                String              @id @default(uuid()) @db.Uuid
  number            String              @unique
  assetId           String              @map("asset_id") @db.Uuid
  incidentId        String?             @map("incident_id") @db.Uuid
  complaint         String
  status            ServiceTicketStatus @default(OPEN)
  vendor            String?
  cost              BigInt?
  actionTaken       String?             @map("action_taken")
  inspection        InspectionResult?
  inspectionNote    String?             @map("inspection_note")
  conditionBefore   AssetCondition      @map("condition_before")
  conditionAfter    AssetCondition?     @map("condition_after")
  assetStatusBefore AssetStatus         @map("asset_status_before")
  startedAt         DateTime?           @map("started_at") @db.Timestamptz(3)
  completedAt       DateTime?           @map("completed_at") @db.Timestamptz(3)
  createdBy         String?             @map("created_by") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  asset    Asset     @relation(fields: [assetId], references: [id])
  incident Incident? @relation(fields: [incidentId], references: [id])

  @@index([assetId])
  @@index([status])
  @@index([incidentId])
  @@map("service_tickets")
}

// Tugas penggantian: aset lama (rusak) dan aset pengganti ditautkan ke insiden yang sama.
// Satu tugas aktif (bukan CANCELLED) per insiden (indeks parsial di migrasi).
model ReplacementTask {
  id                 String            @id @default(uuid()) @db.Uuid
  number             String            @unique
  incidentId         String            @map("incident_id") @db.Uuid
  orderId            String            @map("order_id") @db.Uuid
  pickListId         String            @map("pick_list_id") @db.Uuid
  oldAssetId         String            @map("old_asset_id") @db.Uuid
  productId          String            @map("product_id") @db.Uuid
  replacementAssetId String?           @map("replacement_asset_id") @db.Uuid
  status             ReplacementStatus @default(PENDING_PICK)
  pickedAt           DateTime?         @map("picked_at") @db.Timestamptz(3)
  verifiedAt         DateTime?         @map("verified_at") @db.Timestamptz(3)
  dispatchedAt       DateTime?         @map("dispatched_at") @db.Timestamptz(3)
  receivedAt         DateTime?         @map("received_at") @db.Timestamptz(3)
  receivedBy         String?           @map("received_by") @db.Uuid
  receivedPicId      String?           @map("received_pic_id") @db.Uuid
  receiveCondition   AssetCondition?   @map("receive_condition")
  receiveNote        String?           @map("receive_note")
  cancelledAt        DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  createdBy          String?           @map("created_by") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  incident         Incident    @relation(fields: [incidentId], references: [id])
  order            Order       @relation(fields: [orderId], references: [id])
  oldAsset         Asset       @relation("ReplacementOldAsset", fields: [oldAssetId], references: [id])
  replacementAsset Asset?      @relation("ReplacementNewAsset", fields: [replacementAssetId], references: [id])
  scans            ScanEvent[]

  @@index([incidentId])
  @@index([status])
  @@index([orderId])
  @@map("replacement_tasks")
}

// Notifikasi dalam aplikasi; teks diterjemahkan di klien dari `type` + `params`.
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  entity    String
  entityId  String    @map("entity_id")
  params    Json      @default("{}")
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

// ---------- Fase 06: invoice, pembayaran, pengingat ----------

enum InvoiceStatus {
  ISSUED
  VOID
}

// Pembayaran sewa = pendapatan; deposit dilacak terpisah (bukan pendapatan).
enum PaymentPurpose {
  RENT
  DEPOSIT
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  GATEWAY
  OTHER
}

// PENDING = menunggu verifikasi/konfirmasi gateway; hanya SUCCEEDED yang dihitung sebagai uang diterima.
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  VOIDED
}

enum ReminderKind {
  MANUAL
  AUTO
}

// Satu invoice aktif (ISSUED) per pesanan (indeks parsial di migrasi). Nominal adalah snapshot pesanan.
model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  number        String        @unique
  orderId       String        @map("order_id") @db.Uuid
  status        InvoiceStatus @default(ISSUED)
  rentAmount    BigInt        @map("rent_amount")
  depositAmount BigInt        @map("deposit_amount")
  dueDate       DateTime      @map("due_date") @db.Date
  note          String?
  issuedAt      DateTime      @default(now()) @map("issued_at") @db.Timestamptz(3)
  voidedAt      DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidReason    String?       @map("void_reason")
  createdBy     String?       @map("created_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  order     Order             @relation(fields: [orderId], references: [id])
  payments  Payment[]
  reminders InvoiceReminder[]

  @@index([orderId])
  @@index([status, dueDate])
  @@map("invoices")
}

// Baris pembayaran tidak dihapus dan nominalnya tidak diubah; koreksi = status VOIDED beserta alasan.
model Payment {
  id          String         @id @default(uuid()) @db.Uuid
  invoiceId   String         @map("invoice_id") @db.Uuid
  purpose     PaymentPurpose
  method      PaymentMethod
  status      PaymentStatus
  amount      BigInt
  reference   String?
  note        String?
  paidAt      DateTime       @map("paid_at") @db.Timestamptz(3)
  recordedBy  String?        @map("recorded_by") @db.Uuid
  confirmedBy String?        @map("confirmed_by") @db.Uuid
  confirmedAt DateTime?      @map("confirmed_at") @db.Timestamptz(3)
  voidedAt    DateTime?      @map("voided_at") @db.Timestamptz(3)
  voidReason  String?        @map("void_reason")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId, status])
  @@index([status, paidAt])
  @@map("payments")
}

model InvoiceReminder {
  id        String       @id @default(uuid()) @db.Uuid
  invoiceId String       @map("invoice_id") @db.Uuid
  kind      ReminderKind
  note      String?
  createdBy String?      @map("created_by") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId, createdAt])
  @@map("invoice_reminders")
}
